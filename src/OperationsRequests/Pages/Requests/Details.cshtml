@page "{id:int}"
@model OperationsRequests.Pages.Requests.DetailsModel
@{var r=Model.RequestItem;}
<a asp-page="/Index">&larr; Dashboard</a><h1>@r.RequestNumber — @r.Title</h1><p>@r.Type · @r.Priority · <strong>@r.Status</strong></p><p>@r.Description</p><p>Site: @r.Site.Territory.Country.Name / @r.Site.Territory.Name / @r.Site.Name</p><div asp-validation-summary="All" class="text-danger"></div>@if(Model.CanAct){<form method="post" class="card card-body"><input asp-for="Version" type="hidden"/><textarea asp-for="Note" class="form-control mb-2" placeholder="Required for decline, info request, and resolution"></textarea><div class="btn-group">@foreach(var a in Model.Actions){<button name="Action" value="@a" class="btn btn-outline-primary">@a</button>}</div></form>}<h2>History</h2><table class="table"><tbody>@foreach(var e in r.AuditEvents.OrderByDescending(x=>x.OccurredAt)){<tr><td>@e.OccurredAt.LocalDateTime</td><td>@e.ActorName</td><td>@e.Action</td><td>@e.PreviousStatus ? @e.NewStatus</td><td>@e.Note</td></tr>}</tbody></table><h2>Information exchange</h2>@foreach(var m in r.Messages.OrderBy(x=>x.CreatedAt)){<p><strong>@(m.IsQuestion?"Question":"Response")</strong>: @m.Body</p>}

