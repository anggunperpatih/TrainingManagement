@page
@model OperationsRequests.Pages.Requests.CreateModel
<h1>New request</h1><form method="post"><div class="mb-3"><label>Type</label><select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<OperationsRequests.Domain.RequestType>()" class="form-select"></select></div><div class="mb-3"><label>Priority</label><select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<OperationsRequests.Domain.RequestPriority>()" class="form-select"></select></div><div class="mb-3"><label asp-for="Input.Title"></label><input asp-for="Input.Title" class="form-control"/></div><div class="mb-3"><label asp-for="Input.Description"></label><textarea asp-for="Input.Description" class="form-control"></textarea></div><div class="mb-3"><label>Site</label><select asp-for="Input.SiteId" class="form-select"><option value="">Select site</option>@foreach(var s in Model.Sites){<option value="@s.Id">@s.Territory.Country.Name / @s.Territory.Name / @s.Name</option>}</select></div><button class="btn btn-primary">Submit</button></form>
