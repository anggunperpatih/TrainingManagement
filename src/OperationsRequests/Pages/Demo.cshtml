@page
@model OperationsRequests.Pages.DemoModel
@{ ViewData["Title"] = "Development demo accounts"; }
<h1>Development demo accounts</h1>
<p>This page is unavailable outside Development. Password is the same for every account below.</p>
<table class="table">
    <thead><tr><th>Role</th><th>Email</th><th>Password</th></tr></thead>
    <tbody>
        @foreach (var account in Model.Accounts)
        {
            <tr>
                <td>@account.Role</td>
                <td>@account.Email</td>
                <td>@Model.Password</td>
            </tr>
        }
    </tbody>
</table>
