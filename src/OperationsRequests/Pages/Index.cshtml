@page
@model OperationsRequests.Pages.IndexModel
<div class="d-flex justify-content-between mb-3"><h1>Request dashboard</h1><a class="btn btn-primary" asp-page="/Requests/Create">New request</a></div><div class="row mb-3"><div class="col"><div class="card card-body">Total <strong>@Model.Total</strong></div></div><div class="col"><div class="card card-body">Open <strong>@Model.Open</strong></div></div><div class="col"><div class="card card-body">Overdue (7d) <strong>@Model.Overdue</strong></div></div></div><div class="row"><div class="col"><h5>By status</h5>@foreach(var x in Model.ByStatus){<div>@x.Key: @x.Value</div>}</div><div class="col"><h5>By priority</h5>@foreach(var x in Model.ByPriority){<div>@x.Key: @x.Value</div>}</div><div class="col"><h5>By type</h5>@foreach(var x in Model.ByType){<div>@x.Key: @x.Value</div>}</div></div><h5 class="mt-3">By organisation</h5>@foreach(var x in Model.ByOrganisation){<div>@x.Key: @x.Value</div>}<table class="table mt-3"><thead><tr><th>Number</th><th>Title</th><th>Priority</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model.Requests){<tr><td><a asp-page="/Requests/Details" asp-route-id="@r.Id">@r.RequestNumber</a></td><td>@r.Title</td><td>@r.Priority</td><td>@r.Status</td></tr>}</tbody></table>
