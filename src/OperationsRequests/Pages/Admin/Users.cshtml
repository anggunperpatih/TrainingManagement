@page
@model OperationsRequests.Pages.Admin.UsersModel
<h1>User administration</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post" asp-page-handler="Create" class="card card-body mb-3"><input asp-for="Input.Email" placeholder="Email" class="form-control mb-2"/><input asp-for="Input.DisplayName" placeholder="Display name" class="form-control mb-2"/><input asp-for="Input.Password" type="password" placeholder="Temporary password" class="form-control mb-2"/><select asp-for="Input.Role" class="form-select mb-2">@foreach(var r in OperationsRequests.Domain.Roles.All){<option>@r</option>}</select><select asp-for="Input.CountryId" class="form-select mb-2"><option value="">Country</option>@foreach(var x in Model.Countries){<option value="@x.Id">@x.Name</option>}</select><select asp-for="Input.TerritoryId" class="form-select mb-2"><option value="">Territory</option>@foreach(var x in Model.Territories){<option value="@x.Id">@x.Name</option>}</select><select asp-for="Input.SiteId" class="form-select mb-2"><option value="">Site</option>@foreach(var x in Model.Sites){<option value="@x.Id">@x.Name</option>}</select><button class="btn btn-primary">Create user</button></form><table class="table"><thead><tr><th>Email</th><th>Active</th><th>Assignment</th><th></th></tr></thead><tbody>@foreach(var u in Model.Users){<tr><td>@u.Email</td><td>@u.IsActive</td><td><form method="post" asp-page-handler="Assign"><input name="id" value="@u.Id" type="hidden"/><select name="role">@foreach(var r in OperationsRequests.Domain.Roles.All){<option value="@r">@r</option>}</select><select name="countryId"><option></option>@foreach(var x in Model.Countries){<option value="@x.Id">@x.Name</option>}</select><select name="territoryId"><option></option>@foreach(var x in Model.Territories){<option value="@x.Id">@x.Name</option>}</select><select name="siteId"><option></option>@foreach(var x in Model.Sites){<option value="@x.Id">@x.Name</option>}</select><button class="btn btn-sm btn-outline-primary">Save</button></form></td><td><form method="post" asp-page-handler="Toggle"><input name="id" value="@u.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Toggle active</button></form></td></tr>}</tbody></table>
